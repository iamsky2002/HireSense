# Example environment variables for the backend.
# Set these as real environment variables before running the app
# (in your IDE run config, or export them in your shell). Never commit the real values.

# Secret used to sign JWT tokens. Must be at least 32 characters.
# The app won't start if this is missing (fail-fast).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# MySQL root password. Leave empty for a passwordless local root.
DB_PASSWORD=
